<?xml version="1.0" encoding="utf-8"?>
<!-- أندرويد 12+: على أجهزة بعض الشركات المصنّعة لا يوقف allowBackup="false" النقل المباشر بين جهازين، فتُستثنى بيانات الجلسة صراحةً -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
